{
  "name": "@battis/typescript-config",
  "homepage": "https://github.com/battis/typescript-config#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/battis/typescript-config.git"
  },
  "license": "GPL-3.0",
  "author": {
    "name": "Seth Battis",
    "url": "https://github.com/battis"
  },
  "type": "module",
  "scripts": {
    "setup": "run-s setup:*",
    "setup:prettier": "setup-prettier -f",
    "setup:eslint": "setup-eslint -f",
    "setup:monorepo": "setup-monorepo -f",
    "setup:commit": "setup-commit -f",
    "postinstall": "run-s setup",
    "build": "run-s build:*",
    "build:compile": "lerna run build",
    "build:setup": "run-s setup",
    "build:paths": "monorepo-package-paths -w --author --homepage --repository",
    "build:toc": "toc -O -t ./docs/toc.md -o . ./packages",
    "release": "run-s release:*",
    "release:build": "lerna run --concurrency 1 release",
    "release:git": "git push --follow-tags",
    "release:login": "pnpm login",
    "release:publish": "pnpm publish -r --access public"
  },
  "devDependencies": {
    "@battis/commit": "workspace:*",
    "@battis/eslint": "workspace:*",
    "@battis/monorepo": "workspace:*",
    "@battis/prettier": "workspace:*",
    "@battis/toc": "workspace:*",
    "@tsconfig/node-lts": "catalog:prod",
    "npm-run-all": "catalog:prod"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
