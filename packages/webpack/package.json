{
  "name": "@battis/webpack",
  "version": "2.1.7",
  "description": "Reusable, extensible webpack configurations for different needs",
  "homepage": "https://github.com/battis/typescript-config/tree/main/packages/webpack#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/battis/typescript-config.git",
    "directory": "packages/webpack"
  },
  "license": "GPL-3.0",
  "author": {
    "name": "Seth Battis",
    "url": "https://github.com/battis"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "setup-webpack": "./bin/setup-webpack"
  },
  "scripts": {
    "build": "run-s build:*",
    "build:clean": "run-s clean",
    "build:compile": "tsc",
    "build:copy-html": "copyfiles -u 1 ./src/**/*.html ./dist",
    "clean": "del ./dist/*",
    "release": "commit-and-tag-version --noBumpWhenEmptyChanges",
    "prepack": "run-s build"
  },
  "dependencies": {
    "@qui-cli/core": "^7.0.0",
    "@qui-cli/init": "^1.1.1"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@types/dotenv-webpack": "^7.0.8",
    "@types/node": "^24.13.3",
    "commit-and-tag-version": "^13.1.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "npm-run-all": "^4.1.5"
  },
  "peerDependencies": {
    "@tsconfig/recommended": "*",
    "copy-webpack-plugin": "*",
    "css-loader": "*",
    "css-minimizer-webpack-plugin": "*",
    "dotenv-webpack": "*",
    "favicons": "*",
    "favicons-webpack-plugin": "*",
    "html-webpack-plugin": "*",
    "image-minimizer-webpack-plugin": "*",
    "imagemin": "*",
    "imagemin-gifsicle": "*",
    "imagemin-jpegtran": "*",
    "imagemin-optipng": "*",
    "imagemin-svgo": "*",
    "mini-css-extract-plugin": "*",
    "postcss": "*",
    "postcss-loader": "*",
    "postcss-preset-env": "*",
    "raw-loader": "*",
    "sass": "1.x",
    "sass-loader": "*",
    "style-loader": "*",
    "terser-webpack-plugin": "*",
    "ts-loader": "*",
    "typescript": "5.x",
    "webpack": "5.x",
    "webpack-cli": "*",
    "webpack-dev-server": "*"
  }
}
