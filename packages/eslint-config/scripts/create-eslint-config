#!/usr/bin/env node

import fs from 'node:fs';
import path from 'node:path';

const eslintConfigPath = path.join(
  process.cwd().slice(0, process.cwd().indexOf('node_modules') - 1),
  'esling.config.mjs'
);
if (!fs.existsSync(eslintConfigPath)) {
  fs.writeFileSync(
    eslintConfigPath,
    'export { default as default } from "@battis/eslint-config";'
  );
}
