{
  "$schema": "https://json.schemastore.org/prettierrc.json",
  "singleQuote": true,
  "trailingComma": "none",
  "plugins": [
    "@prettier/plugin-xml",
    "prettier-plugin-ejs",
    "prettier-plugin-jsdoc",
    "prettier-plugin-packagejson",
    "@ianvs/prettier-plugin-sort-imports"
  ],
  "importOrder": ["", "^[.]"],
  "importOrderTypeScriptVersion": "5.9.3",
  "xmlWhitespaceSensitivity": "ignore",
  "overrides": [
    {
      "files": "*.tsx",
      "options": {
        "parser": "typescript"
      }
    }
  ]
}
