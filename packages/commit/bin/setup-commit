#!/usr/bin/env node

import { Init } from '@qui-cli/init';
import { Core, Positionals } from '@qui-cli/core';
import { Shell } from '@qui-cli/shell';
import { Colors } from '@qui-cli/colors';
import ora from 'ora';
import path from 'node:path';

Init.configure({
  enclosingDirectory: false,
  template: path.resolve(import.meta.dirname, '../template')
});
Positionals.requireAtLeast(0);
await Core.run();

const spinner = ora(`Verifying ${Colors.command('pre-commit')} hooks`).start();
Shell.configure({ showCommands: false, logging: false, silent: true });
if (Shell.exec('which pre-commit').stdout !== '') {
  Shell.exec('pre-commit install');
  Shell.exec('pre-commit install --hook-type commit-msg');
  spinner.succeed(`${Colors.command('pre-commit')} hooks registered`);
} else {
  spinner.fail(
    Colors.error(
      `Install pre-commit and then re-run ${Colors.command(process.argv[1])} (see ${Colors.url('https://pre-commit.com/#install')})`
    )
  );
}
