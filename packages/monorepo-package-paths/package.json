{
  "name": "monorepo-package-paths",
  "version": "1.0.0",
  "description": "Update workspace package manifests to use URLs relative to root package manifest",
  "homepage": "https://github.com/battis/typescript-config/tree/main/packages/monorepo-package-paths#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/battis/typescript-config.git",
    "directory": "packages/monorepo-package-paths"
  },
  "license": "GPL-3.0",
  "author": {
    "name": "Seth Battis",
    "url": "https://github.com/battis"
  },
  "type": "module",
  "directories": {
    "bin": "./bin"
  },
  "scripts": {
    "clean": "del ./dist/*",
    "build": "run-s build:*",
    "build:clean": "run-s clean",
    "build:compile": "tsc",
    "release": "commit-and-tag-version --noBumpWhenEmptyChanges",
    "prepack": "run-s build"
  },
  "dependencies": {
    "@battis/import-package-json": "workspace:*",
    "@inquirer/input": "catalog:prod",
    "@qui-cli/colors": "catalog:prod",
    "@qui-cli/core": "catalog:prod",
    "@qui-cli/init": "catalog:prod",
    "@qui-cli/plugin": "catalog:prod",
    "@qui-cli/root": "catalog:prod",
    "@qui-cli/validators": "catalog:prod",
    "glob": "^13.0.6",
    "ora": "catalog:prod",
    "package-json-type": "catalog:common-peer",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "catalog:prod",
    "@types/glob": "^9.0.0",
    "@types/node": "catalog:prod",
    "commit-and-tag-version": "catalog:prod",
    "del-cli": "catalog:prod",
    "npm-run-all": "catalog:prod",
    "typescript": "catalog:prod"
  },
  "peerDependencies": {
    "prettier": "catalog:common-peer"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  }
}
