{
  "name": "monorepo-package-paths",
  "version": "0.4.5",
  "description": "Update workspace package manifests to use URLs relative to root package manifest",
  "homepage": "https://github.com/battis/typescript-config/tree/main/packages/monorepo-package-paths#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/battis/typescript-config.git",
    "directory": "packages/monorepo-package-paths"
  },
  "license": "GPL-3.0",
  "author": {
    "name": "Seth Battis",
    "url": "https://github.com/battis"
  },
  "type": "module",
  "directories": {
    "bin": "./bin"
  },
  "scripts": {
    "clean": "del ./dist/*",
    "build": "run-s build:*",
    "build:clean": "run-s clean",
    "build:compile": "tsc",
    "release": "commit-and-tag-version --noBumpWhenEmptyChanges",
    "prepack": "run-s build"
  },
  "dependencies": {
    "@battis/import-package-json": "workspace:*",
    "@inquirer/input": "^5.1.2",
    "@qui-cli/colors": "^3.2.4",
    "@qui-cli/core": "^7.0.0",
    "@qui-cli/log": "^4.0.4",
    "@qui-cli/plugin": "^4.1.2",
    "@qui-cli/root": "^3.1.1",
    "@qui-cli/validators": "^3.0.5",
    "glob": "^13.0.6",
    "ora": "^9.4.1",
    "package-json-type": "^1.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@types/glob": "^9.0.0",
    "@types/node": "^24.13.2",
    "commit-and-tag-version": "^12.7.3",
    "del-cli": "^7.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "prettier": "^3.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  }
}
