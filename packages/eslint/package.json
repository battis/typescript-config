{
  "name": "@battis/eslint",
  "version": "3.0.6",
  "description": "@battis's [ESLint](https://eslint.org/) static analysis configuration",
  "homepage": "https://github.com/battis/typescript-config/tree/main/packages/eslint#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/battis/typescript-config.git",
    "directory": "packages/eslint"
  },
  "license": "GPL-3.0",
  "author": {
    "name": "Seth Battis",
    "url": "https://github.com/battis"
  },
  "type": "module",
  "main": "./dist/eslint.config.js",
  "types": "./dist/eslint.config.d.ts",
  "bin": {
    "setup-eslint": "./bin/setup-eslint"
  },
  "scripts": {
    "clean": "del ./dist",
    "build": "run-s build:*",
    "build:clean": "run-s clean",
