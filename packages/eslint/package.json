    "commit-and-tag-version": "catalog:prod",
    "del-cli": "catalog:prod",
    "npm-run-all": "catalog:prod",
    "typescript": "catalog:prod"
  },
  "peerDependencies": {
    "@eslint/js": "10.x",
    "@eslint/markdown": "8.x",
    "eslint": "10.x",
    "eslint-config-prettier": "10.x",
    "eslint-plugin-html": "8.x",
