{
  "name": "@battis/eslint",
  "version": "3.0.6",
  "description": "@battis's [ESLint](https://eslint.org/) static analysis configuration",
  "homepage": "https://github.com/battis/typescript-config/tree/main/packages/eslint#readme",
  "repository": {
    "type": "git",
