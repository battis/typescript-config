    "release": "commit-and-tag-version --noBumpWhenEmptyChanges",
    "prepack": "run-s build"
  },
  "dependencies": {
    "@qui-cli/core": "^7.0.0",
    "@qui-cli/init": "^1.1.1"
  },
  "devDependencies": {
    "@battis/workspace": "workspace:*",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint-plugin-markdown": "^2.0.2",
    "@typescript-eslint/utils": "^8.63.0",
    "commit-and-tag-version": "^12.7.3",
    "del-cli": "^7.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@eslint/js": "*",
    "@eslint/markdown": "*",
    "eslint": "10.x",
    "eslint-config-prettier": "*",
    "eslint-plugin-html": "*",
    "globals": "*",
    "typescript-eslint": "*"
  }
