#!/usr/bin/env node

import { Setup } from '@battis/pkg-setup';
import { Core } from '@qui-cli/core';
import fs from 'node:fs';
import { Log } from '@qui-cli/log';
import path from 'node:path';
import { Colors } from '@qui-cli/colors';

Setup.configure({ packageName: '@battis/workspace' });
await Core.run();

const versionrcPath = path.join(process.cwd(), '.versionrc.json');
const packagePath = path.join(process.cwd(), 'package.json');
Log.info({
  versionrcPath,
  versionrcPathExists: fs.existsSync(versionrcPath),
  packagePath,
  packagePathExists: fs.existsSync(packagePath)
});
if (fs.existsSync(versionrcPath) && fs.existsSync(packagePath)) {
  const pkg = JSON.parse(fs.readFileSync(packagePath, 'utf8'));
  fs.writeFileSync(
    versionrcPath,
    fs
      .readFileSync(versionrcPath, 'utf8')
      .replaceAll('{{DIR}}', path.basename(process.cwd()))
      .replaceAll('{{NAME}}', pkg.name)
  );
  Log.info(
    `${Colors.path(versionrcPath, Colors.keyword)} updated for ${Colors.value(pkg.name)}`
  );
} else {
  Log.warning(`${Colors.path(versionrcPath, Colors.keyword)} left unchanged`);
}
