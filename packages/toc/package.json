{
  "name": "@battis/toc",
  "version": "1.0.0-1",
  "description": "Auto-generated package table of contents for monorepo README files",
  "homepage": "https://github.com/battis/typescript-config/tree/main/packages/toc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/battis/typescript-config.git",
    "directory": "packages/toc"
  },
  "author": {
    "name": "Seth Battis",
    "url": "https://github.com/battis"
  },
  "type": "module",
  "directories": {
    "bin": "./bin"
  },
  "scripts": {
    "clean": "del ./dist",
    "build": "run-s build:*",
    "build:clean": "run-s clean",
    "build:compile": "tsc",
    "build:readme": "./scripts/toc",
    "prepack": "run-s build",
    "release": "commit-and-tag-version --noBumpWhenEmptyChanges"
  },
  "dependencies": {
    "@qui-cli/colors": "3.2.5-0",
    "@qui-cli/core": "7.1.0-0",
    "@qui-cli/init": "^2.0.0",
    "@qui-cli/log": "4.0.5-0",
    "@qui-cli/plugin": "4.2.0-0",
    "change-case": "^5.4.4",
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "@battis/descriptive-types": "workspace:*",
    "@qui-cli/markdown": "^2.0.1",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/node": "^24.13.3",
    "del-cli": "^7.0.0",
    "npm-run-all": "^4.1.5",
    "package-json-type": "^1.1.2",
    "typescript": "^5.9.3"
  }
}
