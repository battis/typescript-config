{
  "name": "@battis/toc",
  "version": "1.0.0-1",
  "description": "Auto-generated package table of contents for monorepo README files",
  "homepage": "https://github.com/battis/typescript-config/tree/main/packages/toc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/battis/typescript-config.git",
    "directory": "packages/toc"
  },
  "author": {
    "name": "Seth Battis",
    "url": "https://github.com/battis"
  },
  "type": "module",
  "directories": {
    "bin": "./bin"
  },
  "scripts": {
    "clean": "del ./dist",
    "build": "run-s build:*",
    "build:clean": "run-s clean",
    "build:compile": "tsc",
    "build:readme": "./scripts/toc",
    "prepack": "run-s build",
    "release": "commit-and-tag-version --noBumpWhenEmptyChanges"
  },
  "dependencies": {
    "@qui-cli/colors": "catalog:dev",
    "@qui-cli/core": "catalog:dev",
    "@qui-cli/init": "catalog:dev",
    "@qui-cli/log": "catalog:dev",
    "@qui-cli/plugin": "catalog:dev",
    "change-case": "^5.4.4",
    "prettier": "catalog:common-peer"
  },
  "devDependencies": {
    "@battis/descriptive-types": "workspace:*",
    "@qui-cli/markdown": "catalog:prod",
    "@tsconfig/node-lts": "catalog:prod",
    "@types/node": "catalog:prod",
    "commit-and-tag-version": "catalog:prod",
    "del-cli": "catalog:prod",
    "npm-run-all": "catalog:prod",
    "package-json-type": "catalog:common-peer",
    "typescript": "catalog:prod"
  }
}
